---
interface Props {
  title: string;
  lat: number;
  lng: number;
  zoom?: number;
  mapsUrl: string;
  address: string;
  embedUrl: string;
  variant?: 'biking' | 'satellite';
}

const { title, lat, lng, zoom = 14, mapsUrl, address, embedUrl, variant = 'biking' } = Astro.props;
const apiKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY ?? '';
const useEnhancedMaps = Boolean(apiKey);
const isSatellite = variant === 'satellite';
---

<figure class="border border-gray-800 rounded-2xl overflow-hidden bg-gray-900/40">
  <div class="aspect-video w-full relative bg-gray-900">
    {useEnhancedMaps ? (
      <>
        {isSatellite ? (
          <div
            data-satellite-map
            data-lat={lat}
            data-lng={lng}
            data-zoom={zoom}
            data-address={address}
            class="h-full w-full"
            hidden
            aria-label={`Satellite map for ${title}`}
          />
        ) : (
          <div
            data-biking-map
            data-lat={lat}
            data-lng={lng}
            data-zoom={zoom}
            class="h-full w-full"
            hidden
            aria-label={`Satellite biking map for ${title}`}
          />
        )}
        <iframe
          data-map-fallback
          src={embedUrl}
          title={`Loading map for ${title}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="absolute inset-0 h-full w-full border-0"
          allowfullscreen
        />
      </>
    ) : (
      <iframe
        src={embedUrl}
        title={`Google Maps location for ${title}`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="h-full w-full border-0"
        allowfullscreen
      />
    )}
  </div>
  <figcaption class="px-4 py-3 text-center text-sm text-gray-300">
    {address}
    <span class="mx-2 text-gray-600" aria-hidden="true">·</span>
    <a
      href={mapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="text-speedYellow hover:underline"
    >
      Open in Google Maps
    </a>
  </figcaption>
</figure>
