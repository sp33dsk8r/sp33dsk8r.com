---
interface Props {
  title: string;
  embedUrl: string;
  mapsUrl: string;
  address: string;
}

const { title, embedUrl, mapsUrl, address } = Astro.props;
---

<figure class="border border-gray-800 rounded-2xl overflow-hidden bg-gray-900/40">
  <div class="aspect-video w-full">
    <iframe
      src={embedUrl}
      title={`Google Maps location for ${title}`}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      class="h-full w-full border-0"
      allowfullscreen
    />
  </div>
  <figcaption class="px-4 py-3 text-center text-sm text-gray-300">
    {address}
    <span class="mx-2 text-gray-600" aria-hidden="true">·</span>
    <a
      href={mapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="text-speedYellow hover:underline"
    >
      Open in Google Maps
    </a>
  </figcaption>
</figure>
