---
import Layout from '../layouts/Layout.astro';
import { familyPhotos } from '../data/family';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout
  title="Family - sp33dsk8r"
  description="Family moments and photos from Bryan and the people who matter most."
>
  <main class="bg-speedBlack text-white py-16">
    <div class="max-w-4xl mx-auto px-6">
      <h1 class="text-5xl font-bold mb-4">Family</h1>
      <p class="text-lg text-gray-300 mb-12">Family moments worth remembering.</p>

      <div class="grid sm:grid-cols-2 gap-6 mb-12">
        {familyPhotos.map((photo) => (
          <figure class="border border-gray-800 rounded-2xl overflow-hidden bg-gray-900/40">
            <div class="h-56 flex items-center justify-center overflow-hidden">
              <picture>
                <source srcset={`${base}${photo.webp}`} type="image/webp" />
                <img
                  src={`${base}${photo.src}`}
                  alt={photo.alt}
                  width={photo.width}
                  height={photo.height}
                  class="object-contain max-h-52 w-auto"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>
            <figcaption class="px-4 py-3 text-center text-sm text-gray-300">
              {photo.caption}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </main>
</Layout>
