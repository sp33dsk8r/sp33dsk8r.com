---
import Layout from '../layouts/Layout.astro';
import MapSnapshot from '../components/MapSnapshot.astro';
import { Content } from '../../docs/vacations.md';
import {
  googleMapsEmbedUrl,
  googleMapsUrl,
  sortVacationSpotsByWhenDesc,
  vacationSpots,
} from '../data/vacations';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const mapsApiKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY ?? '';
const sortedVacationSpots = sortVacationSpotsByWhenDesc(vacationSpots);
---

<Layout
  title="Vacation Spots - sp33dsk8r"
  description="Texas vacation spots Bryan recommends — trips worth remembering with maps and highlights."
>
  <main class="bg-speedBlack text-white py-16">
    <div class="max-w-4xl mx-auto px-6">
      <h1 class="text-5xl font-bold mb-12">Vacation Spots</h1>
      <div class="prose prose-invert max-w-none text-lg overflow-x-auto">
        <Content />
      </div>

      {sortedVacationSpots.length > 0 ? (
        <div class="mt-12 flex flex-col gap-16">
          {sortedVacationSpots.map((spot) => (
            <article class="border border-gray-800 rounded-2xl p-8 bg-gray-900/20">
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 mb-4">
                <h2 class="text-3xl font-bold">{spot.name}</h2>
                {spot.when ? (
                  <span class="text-gray-400 text-lg">{spot.when}</span>
                ) : null}
              </div>
              <p class="text-speedYellow text-lg mb-6">{spot.location}</p>

              {spot.lat != null && spot.lng != null ? (
                <MapSnapshot
                  title={spot.name}
                  address={spot.location}
                  lat={spot.lat}
                  lng={spot.lng}
                  zoom={spot.zoom}
                  embedUrl={googleMapsEmbedUrl(spot.lat, spot.lng, spot.zoom)}
                  mapsUrl={googleMapsUrl(spot.lat, spot.lng, spot.zoom)}
                />
              ) : null}

              <p class="mt-6 text-lg leading-relaxed text-gray-200" set:html={spot.description} />

              {spot.highlights && spot.highlights.length > 0 ? (
                <ul class="mt-6 flex flex-wrap gap-2 list-none p-0">
                  {spot.highlights.map((highlight) => (
                    <li class="px-3 py-1 text-sm rounded-full border border-gray-700 text-gray-300">
                      {highlight}
                    </li>
                  ))}
                </ul>
              ) : null}
            </article>
          ))}
        </div>
      ) : (
        <p class="mt-12 text-gray-400 text-lg border border-dashed border-gray-700 rounded-2xl px-8 py-10 text-center">
          No spots listed yet — content coming soon.
        </p>
      )}
    </div>
  </main>
  {mapsApiKey && sortedVacationSpots.some((spot) => spot.lat != null && spot.lng != null) ? (
    <script define:vars={{ mapsApiKey }}>
      import { initBikingMaps } from '../lib/bikingMaps';
      initBikingMaps(mapsApiKey);
    </script>
  ) : null}
</Layout>
