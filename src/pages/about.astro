---
import Layout from '../layouts/Layout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { Content } from '../../docs/about.md';
---

<Layout
  title="About - sp33dsk8r"
  description="Meet Bryan “sp33dsk8r” Taylor — Katy/Houston inline speedskater, endurance cyclist, and MS150 rider."
>
  <main class="bg-speedBlack text-white py-16">
    <div class="max-w-4xl mx-auto px-6">
      <h1 class="text-5xl font-bold mb-12">About</h1>
      <div class="prose prose-invert max-w-none text-lg overflow-x-auto">
        <Content />
      </div>
      <div class="mt-12 p-6 border border-gray-800 rounded-2xl flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <p class="text-gray-300">
          Questions, gear talk, or training notes? Email me, or follow rides and skating updates on X.
        </p>
        <SocialLinks class="text-lg font-medium shrink-0" />
      </div>
    </div>
  </main>
</Layout>
