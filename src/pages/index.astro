---
import Layout from '../layouts/Layout.astro';
import { site } from '../config/site';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout title="sp33dsk8r | Speedskating &amp; Fitness">
  <main class="min-h-screen bg-speedBlack text-white">
    <!-- Hero -->
    <section class="bg-gradient-to-br from-speedBlack via-speedBlue to-speedBlack py-24 relative overflow-hidden">
      <div class="max-w-6xl mx-auto px-6 text-center">
        <h1 class="text-7xl md:text-8xl font-bold tracking-tighter mb-6">
          <span class="text-speedYellow">sp33d</span>sk8r
        </h1>
        <p class="text-2xl md:text-3xl text-gray-300 max-w-2xl mx-auto mb-10">
          Houston speedskating • Fitness • Recreational skating community
        </p>
        <div class="flex flex-col sm:flex-row flex-wrap gap-4 justify-center">
          <a href={`${base}gear`} class="bg-speedYellow hover:bg-yellow-400 text-black font-semibold px-10 py-4 rounded-xl text-lg transition">View Gear</a>
          <a href={`${base}community`} class="border border-speedYellow hover:bg-speedYellow hover:text-black font-semibold px-10 py-4 rounded-xl text-lg transition">Join the Community</a>
          <a
            href={site.x}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 border border-gray-500 hover:border-white hover:bg-white hover:text-black font-semibold px-10 py-4 rounded-xl text-lg transition"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
            Follow {site.xHandle}
          </a>
        </div>
      </div>
    </section>

    <!-- Quick Links -->
    <section class="py-20">
      <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <a href={`${base}about`} class="group p-8 border border-gray-800 hover:border-speedYellow rounded-3xl transition">
          <h3 class="text-2xl font-semibold mb-4">About</h3>
          <p class="text-gray-400">Who I am — skating, cycling, MS150, and the Houston fitness community.</p>
        </a>
        <a href={`${base}history`} class="group p-8 border border-gray-800 hover:border-speedYellow rounded-3xl transition">
          <h3 class="text-2xl font-semibold mb-4">History</h3>
          <p class="text-gray-400">From Mississippi to Michigan and back — then Texas since 1996.</p>
        </a>
        <a href={`${base}gear`} class="group p-8 border border-gray-800 hover:border-speedYellow rounded-3xl transition">
          <h3 class="text-2xl font-semibold mb-4">Gear &amp; Equipment</h3>
          <p class="text-gray-400">Skates, bikes, and training setups I use for Houston skating and endurance riding.</p>
        </a>
        <a href={`${base}community`} class="group p-8 border border-gray-800 hover:border-speedYellow rounded-3xl transition">
          <h3 class="text-2xl font-semibold mb-4">Community &amp; Events</h3>
          <p class="text-gray-400">Houston area sessions, training groups, MS150, and more.</p>
        </a>
      </div>
    </section>
  </main>
</Layout>