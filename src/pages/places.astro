---
import Layout from '../layouts/Layout.astro';
import MapSnapshot from '../components/MapSnapshot.astro';
import { Content } from '../../docs/places.md';
import { googleMapsEmbedUrl, googleMapsUrl, parks } from '../data/places';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const mapsApiKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY ?? '';
---

<Layout title="Places to Skate &amp; Ride - sp33dsk8r">
  <main class="bg-speedBlack text-white py-16">
    <div class="max-w-4xl mx-auto px-6">
      <h1 class="text-5xl font-bold mb-12">Places to Skate &amp; Ride</h1>
      <div class="prose prose-invert max-w-none text-lg overflow-x-auto">
        <Content />
      </div>

      <div class="mt-12 flex flex-col gap-16">
        {parks.map((park) => (
          <article>
            <h2 class="text-3xl font-bold mb-6">{park.name}</h2>
            <MapSnapshot
              title={park.name}
              address={park.address}
              lat={park.lat}
              lng={park.lng}
              zoom={park.zoom}
              embedUrl={googleMapsEmbedUrl(park.lat, park.lng, park.zoom)}
              mapsUrl={googleMapsUrl(park.lat, park.lng)}
            />
            <p class="mt-6 text-lg leading-relaxed text-gray-200" set:html={park.description} />
          </article>
        ))}
      </div>

      <p class="mt-12 text-gray-400 text-base">
        More group rides and events around Houston live on the
        <a href={`${base}community`} class="text-speedYellow hover:underline">Community</a>
        page. For what I'm rolling on at these spots, see
        <a href={`${base}gear`} class="text-speedYellow hover:underline">Gear</a>.
      </p>
      <p class="mt-4 text-gray-400 text-base">
        Have more detail to add?
        <a href={`${base}places-questionnaire.md`} class="text-speedYellow hover:underline" download>
          Download the places questionnaire
        </a>
        , fill it in, and send it back for an update.
      </p>
    </div>
  </main>
  {mapsApiKey ? (
    <script define:vars={{ mapsApiKey }}>
      import { initBikingMaps } from '../lib/bikingMaps';
      initBikingMaps(mapsApiKey);
    </script>
  ) : null}
</Layout>
