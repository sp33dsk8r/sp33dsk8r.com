---
import '../styles/global.css';
const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content="Houston speedskating community • Fitness & recreational skating with sp33dsk8r" />
</head>
<body class="bg-speedBlack text-white font-sans leading-relaxed">
  <nav class="border-b border-gray-700 bg-speedBlack/95 backdrop-blur-md sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-6 py-5 flex justify-between items-center">
      <a href={base} class="flex items-center gap-3 text-3xl font-bold tracking-tighter text-speedYellow">
        SPEEDSK8R
      </a>
      <div class="flex gap-8 text-lg font-medium">
        <a href={base} class="hover:text-speedYellow transition">Home</a>
        <a href={`${base}gear`} class="hover:text-speedYellow transition">Gear</a>
        <a href={`${base}about`} class="hover:text-speedYellow transition">About</a>
        <a href={`${base}community`} class="hover:text-speedYellow transition">Community</a>
      </div>
    </div>
  </nav>

  <slot />

  <footer class="border-t border-gray-700 py-12 mt-20 bg-speedBlack">
    <div class="max-w-6xl mx-auto px-6 text-center text-gray-400">
      <p>© 2026 sp33dsk8r.com • Built with ❤️ for the Houston skating community</p>
    </div>
  </footer>
</body>
</html>